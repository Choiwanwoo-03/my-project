# 이 파일을 복사해서 .env.local로 저장하고 실제 값을 채운다.
# .env.local은 .gitignore에 등록돼 있어 git에 올라가지 않는다.

# MongoDB Atlas 클러스터 연결 주소 (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
# 사용할 데이터베이스 이름
MONGODB_DB="music_albums"

# Spotify Developer Dashboard(developer.spotify.com/dashboard)에서 앱을 만들면 발급된다
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
# 위 앱 설정의 Redirect URI와 정확히 같아야 한다 (로컬: http://localhost:3000/api/spotify/callback)
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/spotify/callback"

# 등록·수정·삭제와 재생을 잠그는 비밀번호. 비워두면 로컬 개발에서는 잠기지 않고,
# 배포(production) 환경에서는 안전하게 전부 막힌다(misconfigured).
PLAYER_PASSWORD=""

# Vercel Blob 저장소 토큰 (Vercel 프로젝트 > Storage > Blob 에서 발급)
BLOB_READ_WRITE_TOKEN=""
